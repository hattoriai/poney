{
  "name": "@hattoriai/poney-react",
  "version": "0.1.1",
  "type": "module",
  "description": "Renderers for Poney documents in React: every diagram type and walkthrough stories, with a plain stylesheet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hattoriai/poney.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/hattoriai/poney#readme",
  "bugs": "https://github.com/hattoriai/poney/issues",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "poney-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "poney-source": "./src/styles/index.css",
      "default": "./dist/poney.css"
    },
    "./styles.min.css": "./dist/poney.min.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:styles": "node scripts/build-styles.mjs",
    "build": "tsup && node scripts/build-styles.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@hattoriai/poney-core": "0.1.1",
    "@hattoriai/poney-layout": "0.1.1",
    "lucide-react": "^1.75.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "8.5.1"
  }
}
