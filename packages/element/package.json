{
  "name": "@hattoriai/poney-element",
  "version": "0.3.0",
  "type": "module",
  "description": "<poney-diagram>: a custom element that draws a Poney view or walkthrough scene in any web page, with no framework. Also built as one file, poney.js, with poney.css.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hattoriai/poney.git",
    "directory": "packages/element"
  },
  "homepage": "https://github.com/hattoriai/poney#readme",
  "bugs": "https://github.com/hattoriai/poney/issues",
  "sideEffects": [
    "*.css",
    "./src/browser.ts",
    "./dist/browser/poney.js"
  ],
  "exports": {
    ".": {
      "poney-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./poney.js": "./dist/browser/poney.js",
    "./poney.min.js": "./dist/browser/poney.min.js",
    "./poney.css": "./dist/browser/poney.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-browser.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@hattoriai/poney-core": "0.3.0",
    "@hattoriai/poney-diagrams": "0.3.0",
    "@hattoriai/poney-ext-ownership": "0.3.0",
    "@hattoriai/poney-ext-security": "0.3.0",
    "@hattoriai/poney-layout": "0.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "tsup": "8.5.1"
  }
}
