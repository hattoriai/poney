{
  "name": "@hattoriai/poney",
  "version": "0.3.1",
  "type": "module",
  "description": "Poney: explain software in diagrams that agents write and people read. The CLI (render, check, import), the MCP server for agents, and Poney Studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hattoriai/poney.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/hattoriai/poney#readme",
  "bugs": "https://github.com/hattoriai/poney/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "poney": "./bin/poney.mjs",
    "poney-mcp": "./bin/poney-mcp.mjs"
  },
  "exports": {
    ".": {
      "poney-source": "./src/ops.ts",
      "types": "./dist/ops.d.ts",
      "default": "./dist/ops.js"
    },
    "./live": {
      "poney-source": "./src/live/types.ts",
      "types": "./dist/live/types.d.ts",
      "default": "./dist/live/types.js"
    },
    "./plugins": {
      "poney-source": "./src/plugins/index.ts",
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "brief.md",
    "brief-change.md",
    "brief-tour.md",
    "examples",
    "studio"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-studio.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.112.0",
    "@agentclientprotocol/codex-acp": "^2.12.1",
    "@agentclientprotocol/sdk": "^2.12.0",
    "@hattoriai/poney-core": "0.3.1",
    "@hattoriai/poney-diagrams": "0.3.1",
    "@hattoriai/poney-ext-ownership": "0.3.1",
    "@hattoriai/poney-ext-security": "0.3.1",
    "@hattoriai/poney-layout": "0.3.1",
    "@hattoriai/poney-render": "0.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "^4.23.15"
  }
}
