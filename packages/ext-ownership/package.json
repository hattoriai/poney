      "poney-source": "./src/layout.ts",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./diagram": {
      "poney-source": "./src/diagram.tsx",
      "types": "./dist/diagram.d.ts",
      "default": "./dist/diagram.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@hattoriai/poney-core": "0.1.0",
    "@hattoriai/poney-layout": "0.1.0",
    "@hattoriai/poney-react": "0.1.0",
    "lucide-react": "^1.75.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "tsup": "8.5.1"
  }
}
