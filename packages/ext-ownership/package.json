{
  "name": "@hattoriai/poney-ext-ownership",
  "version": "0.1.0",
  "type": "module",
  "description": "Poney extension: teams, who owns what, on-call, and a team map.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hattoriai/poney.git",
    "directory": "packages/ext-ownership"
  },
  "homepage": "https://github.com/hattoriai/poney#readme",
  "bugs": "https://github.com/hattoriai/poney/issues",
  "exports": {
    ".": {
      "poney-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
