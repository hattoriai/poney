{
  "name": "poney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Poney: an open format for describing software, and a studio for exploring it.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @poney/studio",
    "build": "npm run build -w @poney/studio",
    "preview": "npm run preview -w @poney/studio",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/layout && tsc -p packages/react && tsc -p packages/ext-ownership && tsc -p packages/examples && tsc -p packages/agent && tsc -p apps/studio",
    "spec": "tsx scripts/build-spec.ts",
    "poney": "node packages/agent/bin/poney.mjs",
    "mcp": "node packages/agent/bin/poney-mcp.mjs",
    "studio": "node packages/agent/bin/poney.mjs studio"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "^2.1.9",
    "zod-to-json-schema": "^3.25.2"
  }
}
